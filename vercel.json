{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/node/ai.js": {
      "maxDuration": 60
    },
    "api/go/ai.go": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/node/grammar",
      "destination": "/api/node/terms?_api=grammar"
    },
    {
      "source": "/api/go/grammar",
      "destination": "/api/go/terms?_api=grammar"
    },
    {
      "source": "/api/node/tai-khoan",
      "destination": "/api/node/quan-ly?_api=tai-khoan"
    },
    {
      "source": "/api/go/tai-khoan",
      "destination": "/api/go/quan-ly?_api=tai-khoan"
    }
  ]
}
