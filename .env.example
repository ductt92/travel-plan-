# Sao thành .env.local rồi điền. .env.local không đưa lên git.
# Trên Vercel: DATABASE_URL tự có khi gắn Neon (Storage), hai biến còn lại thêm ở Settings → Environment Variables.
DATABASE_URL=postgres://postgres:dev@127.0.0.1:5433/dadiqua
APP_SECRET=doi-ma-nay
# Mật khẩu riêng của trang hsk6 (Ngọc đăng nhập bằng mã này), dùng thay APP_SECRET cho /api/*/terms và /api/*/ai
HSK6_PASS=
GEMINI_API_KEY=
# Các AI miễn phí dự phòng cho /api/*/ai: AI đang dùng hết lượt thì chuyển sang cái kế tiếp (thứ tự AI_ORDER).
# Để trống cái nào thì bỏ qua cái đó. Đổi model bằng GEMINI_MODELS, GROQ_MODELS… (cách nhau bằng dấu phẩy).
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
# AI_ORDER=gemini,groq,openrouter,mistral
# Lớp học trực tiếp (lop-hoc/): khóa Ably dạng appId.keyId:secret; giáo viên đăng nhập bằng HSK6_PASS hoặc APP_SECRET
ABLY_API_KEY=
# TURN cho video lớp học khi hai máy khác mạng: Cloudflare Realtime TURN (hoặc TURN_URLS, TURN_USERNAME, TURN_CREDENTIAL)
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# Cloudflare R2 cho file của trang quản lý (/api/*/quan-ly): bucket, khóa API quyền Object Read & Write chỉ cho bucket đó,
# R2_PUBLIC_URL là địa chỉ công khai của bucket (r2.dev hoặc tên miền riêng, không có / cuối). Cách tạo: backend/README.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
